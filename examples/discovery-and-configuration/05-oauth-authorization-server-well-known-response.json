    "private_key_jwt"
  ],
  "revocation_endpoint_auth_signing_alg_values_supported": [
    "ES256"
  ],
  "code_challenge_methods_supported": [
    "S256"
  ],
  "dpop_signing_alg_values_supported": [
    "ES256"
  ],
  "api_versions_supported": [
    {
      "major_version": 1,
      "version": "1.0.0",
      "status": "deprecated"
    },
    {
      "major_version": 2,
      "version": "2.0.0",
      "status": "stable"
    }
  ]
}
