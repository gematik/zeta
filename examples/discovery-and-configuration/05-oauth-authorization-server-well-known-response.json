{
  "issuer": "https://auth-server.example.de",
  "authorization_endpoint": "https://auth-server.example.de/auth",
  "token_endpoint": "https://auth-server.example.de/token",
  "pushed_authorization_request_endpoint": "https://auth-server.example.de/par",
  "require_pushed_authorization_requests": true,
  "nonce_endpoint": "https://auth-server.example.de/nonce",
  "registration_endpoint": "https://auth-server.example.de/register",
  "redirection_endpoint": "https://auth-server.example.de/oidc/redirect",
  "jwks_uri": "https://auth-server.example.de/jwks",
  "scopes_supported": [
    "openid",
    "e-rezept",
    "e-patientenakte"
  ],
  "response_types_supported": [
    "code"
  ],
  "grant_types_supported": [
    "authorization_code",
    "urn:ietf:params:oauth:grant-type:token-exchange",
