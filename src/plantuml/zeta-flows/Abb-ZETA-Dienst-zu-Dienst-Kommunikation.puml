@startuml "Abb-ZETA-Dienst-zu-Dienst-Kommunikation"
!include ../puml-layout.txt


box "TI 2.0 Dienst Anbieter A" PROVIDER_COLOR
  box "ZETA Guard A" ZETA_GUARD_COLOR
    participant "cronjob Pod" as cronjobClient <<zeta>>
    participant "PDP\nAuthorization Server" as AuthS <<zeta>>
    participant "etcd" as etcd <<zeta>>
  end box
    participant "Resource Server" as workloadClient <<provider>>
end box

participant "gematik" as gem

box "TI 2.0 Dienst Anbieter B" PROVIDER_COLOR
  box "ZETA Guard B" ZETA_GUARD_COLOR
    participant "PDP\nAuthorization Server" as ZetaSTS <<zeta>>
    participant "PEP\nHTTP Proxy" as HP <<zeta>>
    participant "PDP\nPolicy Engine" as OPA <<zeta>>
  end box
    participant "Resource Server" as ResourceServer <<provider>>
end box

ref over AuthS, gem: **Registrierung der Issuer URI oder des Signing Keys des Anbieters (Workload Identity Pool)**

ref over gem, OPA: **Verteilung der Zugriffsberechtigten Workloads an die Policy Engine**

par Regelmäßiger Token Exchange (Subject Token gegen Access Token)
  etcd++
  cronjobClient++
  cronjobClient -> AuthS++: Fordert Subject Token an
  AuthS --> cronjobClient--: Subject Token

  cronjobClient -> ZetaSTS++: Fordert Access-Token an\n(Token Exchange mit Subject Token)
  ZetaSTS -> ZetaSTS: Prüft iss (konfigurierter Aussteller)\nund kid (gültiger JWKS-Cache des Ausstellers)
  alt kid nicht im gültigen JWKS-Cache (nur Aussteller mit jwks_uri)
    opt Abruf nicht gesperrt (höchstens einmal je Minute und Aussteller)
      ZetaSTS -> AuthS++:  GET jwks_uri (konfiguriert)
      alt JWKS abrufbar
        AuthS --> ZetaSTS--: JWKS
        ZetaSTS -> ZetaSTS: Aktualisiert JWKS-Cache des Ausstellers
      else JWKS nicht abrufbar
        deactivate AuthS
      end alt
    end opt
    opt keine gültige Kopie des JWKS
      ZetaSTS --> cronjobClient: 503 Service Unavailable\n{"error": "temporarily_unavailable"}
      note over cronjobClient, ZetaSTS: Ablauf endet
    end opt
  end alt
  ZetaSTS -> ZetaSTS: Validiert Subject Token (Signaturprüfung)

  alt Validation successful
    ZetaSTS -> ZetaSTS: Policy Engine Input erstellen
    ZetaSTS -> OPA++: POST /v1/data/authz {Policy Engine Input}
    OPA --> ZetaSTS--: Policy Decision
    alt Policy Decision allow
      ZetaSTS --> cronjobClient: 200 OK\n{access_token, token_type=Bearer}
      cronjobClient -> etcd: Speichert Access-Token als Secret
    else Policy Decision deny
      ZetaSTS --> cronjobClient--: 403 Forbidden {"error": "access_denied"}
    end alt
  else Validation fehlerhaft
    ZetaSTS --> cronjobClient--: 400 Bad Request {"error": "invalid_grant"}
  end alt
  cronjobClient--
end
par Ressourcenzugriff mit Access Token
  workloadClient++
  workloadClient -> etcd: Liest Access-Token\nSecret aus
  workloadClient -> HP++: Anfrage mit Access-Token
  HP -> HP: Validiert Access-Token\n(Bearer, nur auf Dienst-zu-Dienst-Routen)
   alt Erfolgreiche Validierung
    HP -> ResourceServer++: Weiterleitung der Anfrage mit Access-Token
    ResourceServer --> HP--: Antwort
    HP --> workloadClient: Antwort
   else Fehlgeschlagene Validierung
      HP --> workloadClient--: Fehler 401 Unauthorized
   end

  deactivate cronjobClient
end
@enduml