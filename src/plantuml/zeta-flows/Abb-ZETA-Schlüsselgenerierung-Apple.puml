@startuml "Abb-ZETA-Schlüsselgenerierung-Apple"
!include ../puml-layout.txt

participant Apple
box "Device" DEVICE_COLOR
  participant "Secure Enclave" as SE LEI_COMPONENT_COLOR
  participant "AppleOS (macOS, iOS, iPadOS)" as AppleOS LEI_COMPONENT_COLOR
  box "App" PRIMAERSYSTEM_COLOR
    participant "ZETA Client" as Client <<zeta>>
  end box
end box

Client++
AppleOS++
Client --> Client: Installation (User Space)

alt Secure Enclave und App Attest verfügbar
== Client Instance Key Pair (PrK.Client.Sig; PuK.Client.Sig) ==
      Client -> AppleOS: SecKeyCreateRandomKey\n(für PrK.Client.Sig, PuK.Client.Sig in SE)
    note left of Client: Generierung des primären Schlüssels\nfür Client Assertions.
      AppleOS -> SE++: Generiere Schlüssel (Client.Sig)
      SE --> AppleOS--: keyId (Referenz für PrK.Client.Sig)
      AppleOS --> Client: keyId (Referenz für PrK.Client.Sig)

    == Hardware-Attestierung (Attestation Key, App Attest) ==
    note left of Client: Generierung des dedizierten Attestation Keys\nund einmalige Attestierung gegen Apple CA.
    Client -> AppleOS: DCAppAttestService.shared.generateKey()
    AppleOS -> SE++: Generiere AK-Schlüsselpaar in SE
    SE --> AppleOS--: keyId_AK (Handle für PrK.AK.Sig)
    AppleOS --> Client: keyId_AK
    Client -> Client: Berechne challenge =\nSHA-256(PuK.Client.Sig)

    Client -> AppleOS: DCAppAttestService.shared.attestKey(\n  keyId_AK, clientDataHash = challenge)
    AppleOS -> SE++: Erstelle Hardware-Signatur über challenge
    SE --> AppleOS--: Hardware-Signatur
    AppleOS -> Apple++: Verifiziere Signatur & erstelle CBOR\n(X.509-Kette + Receipt)
    Apple --> AppleOS--: apple_attestation_object
    AppleOS --> Client: apple_attestation_object

== Expliziter Besitznachweis (Proof of Possession) ==
    note left of Client
      Besitznachweis des Client Instance Keys. Das apple_attestation_object beweist die HW-Bindung des AK;
      diese Signatur beweist den physischen Besitz von PrK.Client.Sig.
      Legacy-Form ohne nonce (bis 01.01.2028, A_30193). Mit nonce erzeugt der Client
      signed_hash_puk_client_sig erst bei der Registrierung nach GET /nonce über
      SHA-256(PuK.Client.Sig || nonce) (Abb-ZETA-DCR-für-mobile-Clients).
    end note
    Client -> AppleOS: SecKeyCreateSignature(\n  PrK.Client.Sig, SHA-256(PuK.Client.Sig))
    AppleOS -> SE++: Signiere Hash mit PrK.Client.Sig
    SE --> AppleOS--: ECDSA Signatur
    AppleOS --> Client: signed_hash_puk_client_sig

else Fallback: keine Secure Enclave oder App Attest nicht verfügbar
== Client Instance Key Pair (PrK.Client.Sig; PuK.Client.Sig) ==
    note left of Client
      Es gilt die Software Attestierung (A_30480).
      Der Client Instance Key wird trotzdem in der Secure Enclave
      erzeugt, sofern das Gerät eine bereitstellt (A_30481).
    end note
    alt Secure Enclave vorhanden
      Client -> AppleOS: SecKeyCreateRandomKey\n(für PrK.Client.Sig, PuK.Client.Sig in SE)
      AppleOS -> SE++: Generiere Schlüssel (Client.Sig)
      SE --> AppleOS--: keyId (Referenz für PrK.Client.Sig)
      AppleOS --> Client: keyId (Referenz für PrK.Client.Sig)
    else keine Secure Enclave
      Client -> Client: Generiere PrK.Client.Sig,\nPuK.Client.Sig (ECDSA P-256)
      note left of Client
        Ausnahme nach Tab-ZETA-Client-Keys: Software-Verschlüsselung
        mit einem vom Anmeldepasswort abgeleiteten Schlüssel
        (Keychain, gerätegebunden, ohne iCloud-Synchronisation;
        iOS/iPadOS: kSecAttrAccessibleWhenUnlockedThisDeviceOnly;
        macOS: Login- bzw. Data-Protection-Keychain);
        kein Klartext-Persistieren (A_30482).
      end note
      Client -> Client: Speichere PrK.Client.Sig verschlüsselt
    end
end

@enduml